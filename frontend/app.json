{
  "expo": {
    "name": "DeudaFácil",
    "slug": "deudafacil-app",
    "scheme": "deudafacil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/deudafacil-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "DeudaFácil convierte tu voz en texto para que revises la deuda antes de guardarla.",
        "NSMicrophoneUsageDescription": "DeudaFácil necesita el micrófono para dictar los datos de una deuda."
      }
    },
    "android": {
      "package": "com.vaniag.deudafacilapp",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#107D70",
        "foregroundImage": "./assets/deudafacil-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/deudafacil-logo.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DeudaFácil necesita el micrófono para dictar los datos de una deuda.",
          "speechRecognitionPermission": "DeudaFácil convierte tu voz en texto para que revises la deuda antes de guardarla."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bd94c094-c112-4ce4-989a-7259c0ed5d3f"
      }
    },
    "owner": "vaniag"
  }
}
